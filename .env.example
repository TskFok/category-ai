# Application
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Auth (FIX-04: strong >=16 char token required in production)
ADMIN_API_TOKEN=
REVIEWER_API_TOKEN=
READER_API_TOKEN=

# Database (PostgreSQL + pgvector)
POSTGRES_USER=ncke
POSTGRES_PASSWORD=ncke_password
POSTGRES_DB=ncke
DATABASE_URL=postgresql+psycopg://ncke:ncke_password@postgres:5432/ncke

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# DeepSeek API (never expose to frontend)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-replace-with-your-deepseek-key
DEEPSEEK_EXTRACT_MODEL=deepseek-flash
DEEPSEEK_ANALYSIS_MODEL=deepseek-v4-pro
DEEPSEEK_MOCK_MODE=false

# LLM Reliability & Budget
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
JOB_BUDGET_LIMIT=50.0
S5_DEEP_ANALYSIS_TOP_N=10
S5_ANALYZE_ALL_CHARACTERS=true

# Model Pricing (USD per 1M tokens, configurable)
PRICE_EXTRACT_INPUT_PER_1M=0.14
PRICE_EXTRACT_OUTPUT_PER_1M=0.28
PRICE_ANALYSIS_INPUT_PER_1M=0.55
PRICE_ANALYSIS_OUTPUT_PER_1M=2.19

# File Storage & Upload Limits
STORAGE_ROOT=/data/storage
AUDIO_STORAGE_ROOT=/data/storage/audio
MAX_UPLOAD_BYTES=52428800

# Episode & Dialogue Script Defaults
EPISODE_TARGET_MINUTES=25
EPISODE_CHARS_PER_MINUTE=260
SPEAKER_REVIEW_THRESHOLD=0.80
ALLOW_LOW_CONFIDENCE_AUTO_PASS=false

# CosyVoice v3.5 Flash TTS & Audio Export (Beijing region official API)
TTS_PROVIDER=cosyvoice
COSYVOICE_API_KEY=
COSYVOICE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
COSYVOICE_TTS_ENDPOINT=/services/audio/tts/SpeechSynthesizer
COSYVOICE_VOICE_DESIGN_ENDPOINT=/services/audio/tts/customization
COSYVOICE_VOICE_ENROLLMENT_MODEL=voice-enrollment
COSYVOICE_MODEL=cosyvoice-v3.5-flash
TTS_MOCK_MODE=true
TTS_MAX_CONCURRENCY=2
TTS_MAX_RETRIES=3
TTS_TIMEOUT_SECONDS=120
TTS_MAX_CHARS_PER_REQUEST=400
TTS_UNIT_SAFETY_MARGIN=20
# 2026-11-19 Beijing region public rate: 0.80 CNY / 10k chars
TTS_PRICE_PER_10K_CHARS=0.80
TTS_CURRENCY=CNY
LLM_CURRENCY=USD
TTS_DAILY_BUDGET_LIMIT=100.0
ALLOW_MOCK_AUDIO_EXPORT=false

# Short-lived HMAC-signed media token TTL (seconds)
MEDIA_TOKEN_TTL_SECONDS=300

FFMPEG_BIN=ffmpeg
AUDIO_OUTPUT_FORMAT=mp3
AUDIO_BITRATE=128k
AUDIO_SAMPLE_RATE=24000
